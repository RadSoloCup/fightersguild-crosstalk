# ── Fluxer (self-hosted chat) ──────────────────────────────────────────────
FLUXER_ORIGIN=https://chat.example.com
# One dedicated bot account. Invite it to the guild with:
#   View Channels, Send Messages, Embed Links, Attach Files,
#   Read Message History, Manage Webhooks, Connect, Speak, Use Voice Activity
#   <origin>/api/v1/oauth2/authorize?client_id=<APP_ID>&scope=bot&permissions=573688832&guild_id=<GUILD_ID>
# One Fluxer bot can hold several voice channels at once, so only one is needed.
FLUXER_BOT_TOKEN=
FLUXER_GUILD_ID=

# ── Discord ────────────────────────────────────────────────────────────────
# One or more bot tokens, comma-separated. The FIRST runs the text bridge and
# the announcements; each EXTRA one is a voice worker. A Discord bot can only
# be in one voice channel per server, so two tokens = two voice channels
# bridged at once, three = three, and so on.
# Every bot: enable the "Message Content Intent" (only the first uses it, but
# it's harmless) and invite each to the SAME server with the same permissions:
#   https://discord.com/oauth2/authorize?client_id=<APP_ID>&scope=bot&permissions=573688832
DISCORD_BOT_TOKENS=
DISCORD_GUILD_ID=

# ── Bridging ───────────────────────────────────────────────────────────────
# Text/voice channels pair automatically when they share a name on both sides
# (case/spacing/emoji-insensitive). Add odd pairs, or exclude channels:
# CHANNEL_OVERRIDES=general-chat=general, ops-room:operations
# CHANNEL_EXCLUDE=admin, staff-only

# SYNC_EDITS=true
# SYNC_DELETES=true
# TAG_FLUXER= (Fluxer)          # optional display-name suffix on bridged users
# TAG_DISCORD= (Discord)

# ── Presence announcements ─────────────────────────────────────────────────
# Post "X joined / left voice #channel" lines. ANNOUNCE_CHANNEL is a channel
# NAME, resolved on each side. Leave blank to disable.
ANNOUNCE_CHANNEL=
# ANNOUNCE_TO=both              # both | fluxer | discord
# ANNOUNCE_JOINS=true
# ANNOUNCE_LEAVES=true
# ANNOUNCE_BRIDGE=true          # also announce when the voice bridge (dis)connects a channel

# ── Voice bridge ───────────────────────────────────────────────────────────
# VOICE_BRIDGE=true
# VOICE_IDLE_LEAVE_MS=20000
# Bot ids that shouldn't count as "someone is in the channel" (DJ / SC-tools):
# VOICE_IGNORE_IDS=

# LiveKit signalling override, if the container can't reach the advertised
# endpoint (mirrors the DJ bot's escape hatch):
# LIVEKIT_ENDPOINT_OVERRIDE=ws://127.0.0.1:7880

# LOG_LEVEL=info   # error | warn | info | debug
