# ── Fluxer (self-hosted chat) ──────────────────────────────────────────────
FLUXER_ORIGIN=https://chat.example.com
# A dedicated bot account's token. Invite it to the guild with:
#   View Channels, Send Messages, Embed Links, Attach Files,
#   Read Message History, Manage Webhooks, Connect, Speak, Use Voice Activity
#   <origin>/api/v1/oauth2/authorize?client_id=<APP_ID>&scope=bot&permissions=573688832&guild_id=<GUILD_ID>
FLUXER_BOT_TOKEN=
FLUXER_GUILD_ID=

# ── Discord ────────────────────────────────────────────────────────────────
# Bot token from the Discord developer portal. Enable the "MESSAGE CONTENT
# INTENT" for the app. Invite it with the same permission set:
#   https://discord.com/oauth2/authorize?client_id=<APP_ID>&scope=bot&permissions=573688832
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ── Bridging ───────────────────────────────────────────────────────────────
# Text/voice channels are paired automatically when they share a name on both
# sides (case/spacing/emoji-insensitive). Add odd pairs here:
#   CHANNEL_OVERRIDES=general-chat=general, ops-room:operations
# CHANNEL_OVERRIDES=
# Names to never bridge:
# CHANNEL_EXCLUDE=admin, staff-only
# CHANNEL_OVERRIDES / CHANNEL_EXCLUDE match loosely by normalised name.

# SYNC_EDITS=true
# SYNC_DELETES=true
# Optional display-name suffix so bridged users read as remote:
# TAG_FLUXER= (Fluxer)
# TAG_DISCORD= (Discord)

# ── Voice bridge ───────────────────────────────────────────────────────────
# VOICE_BRIDGE=true
# VOICE_IDLE_LEAVE_MS=20000
# Bot ids that shouldn't count as "someone is in the channel" (DJ / SC-tools):
# VOICE_IGNORE_IDS=

# LiveKit signalling override, if the container can't reach the advertised
# endpoint (mirrors the DJ bot's escape hatch):
# LIVEKIT_ENDPOINT_OVERRIDE=ws://127.0.0.1:7880

# LOG_LEVEL=info   # error | warn | info | debug
